{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User profiles for authenticated LatinoMigra users",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "countryOfOrigin": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "savedScholarships": {
      "title": "Saved Scholarships",
      "description": "Scholarships bookmarked by users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "scholarshipId": { "type": "string" },
        "scholarshipTitle": { "type": "string" },
        "country": { "type": "string" },
        "savedAt": { "type": "string" }
      },
      "required": ["userId", "scholarshipId"]
    },
    "userNotes": {
      "title": "User Notes",
      "description": "Personal notes and saved AI guidance for users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "content"]
    },
    "migrationPlans": {
      "title": "Migration Plans",
      "description": "Personalized migration simulation plans for users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "originCountry": { "type": "string" },
        "destinationCountry": { "type": "string" },
        "migrationPathway": { "type": "string" },
        "familyStatus": { "type": "string" },
        "numberOfChildren": { "type": "number" },
        "climatePreference": { "type": "string" },
        "lifestylePreference": { "type": "string" },
        "estimatedMonthlyBudgetEur": { "type": "number" },
        "initialSavingsBudgetEur": { "type": "number" },
        "hasTraveledBefore": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "originCountry", "destinationCountry"]
    },
    "userPreferences": {
      "title": "User Preferences",
      "description": "Alert and notification preferences for users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "notifyScholarshipDeadlines": { "type": "boolean" },
        "notifyVisaPolicyChanges": { "type": "boolean" },
        "notifyForumReplies": { "type": "boolean" },
        "notifyWeeklyDigest": { "type": "boolean" },
        "destinationCountry": { "type": "string" },
        "preferredArea": { "type": "string" },
        "pushEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    },
    "feedbackSuggestions": {
      "title": "Feedback Suggestions",
      "description": "Community feedback and feature proposals",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 3000 },
        "category": { "type": "string" },
        "authorName": { "type": "string" },
        "authorCountry": { "type": "string" },
        "upvotes": { "type": "number" },
        "status": { "type": "string" },
        "officialResponse": { "type": "string" },
        "createdAt": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["title", "description", "category"]
    },
    "forumPosts": {
      "title": "Forum Posts",
      "description": "Community questions and migration experiences",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 300 },
        "content": { "type": "string", "maxLength": 5000 },
        "author": { "type": "string", "maxLength": 100 },
        "authorCountry": { "type": "string", "maxLength": 60 },
        "country": { "type": "string", "maxLength": 60 },
        "city": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 80 },
        "likes": { "type": "number" },
        "repliesCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["title", "content", "category", "country"]
    },
    "forumReplies": {
      "title": "Forum Replies",
      "description": "Community answers to forum questions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postId": { "type": "string" },
        "author": { "type": "string", "maxLength": 100 },
        "text": { "type": "string", "maxLength": 3000 },
        "createdAt": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["postId", "text", "author"]
    },
    "scholarships": {
      "title": "Scholarships",
      "description": "Dynamic catalog of international scholarships updated automatically",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "institution": { "type": "string" },
        "institutionType": { "type": "string" },
        "officialPortalName": { "type": "string" },
        "country": { "type": "string" },
        "countryCode": { "type": "string" },
        "area": { "type": "string" },
        "supportType": { "type": "string" },
        "deadline": { "type": "string" },
        "deadlineDate": { "type": "string" },
        "daysLeft": { "type": "number" },
        "isUrgent": { "type": "boolean" },
        "description": { "type": "string" },
        "requirements": { "type": "array", "items": { "type": "string" } },
        "benefits": { "type": "array", "items": { "type": "string" } },
        "link": { "type": "string" },
        "imageUrl": { "type": "string" },
        "academicYear": { "type": "string" },
        "lastVerifiedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "country", "link"]
    }
  },
  "firestore": {
    "/scholarships/{scholarshipId}": {
      "schema": { "$ref": "#/entities/scholarships" },
      "description": "Public catalog of scholarships"
    },
    "/forumPosts/{postId}": {
      "schema": { "$ref": "#/entities/forumPosts" },
      "description": "Public community forum posts"
    },
    "/forumPosts/{postId}/replies/{replyId}": {
      "schema": { "$ref": "#/entities/forumReplies" },
      "description": "Subcollection of replies for each forum post"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/users" },
      "description": "User profile data"
    },
    "/savedScholarships/{docId}": {
      "schema": { "$ref": "#/entities/savedScholarships" },
      "description": "Saved scholarship bookmarks"
    },
    "/userNotes/{noteId}": {
      "schema": { "$ref": "#/entities/userNotes" },
      "description": "Personal notes created by users"
    },
    "/migrationPlans/{planId}": {
      "schema": { "$ref": "#/entities/migrationPlans" },
      "description": "User personalized migration plans"
    },
    "/userPreferences/{prefId}": {
      "schema": { "$ref": "#/entities/userPreferences" },
      "description": "User alert and notification settings"
    },
    "/feedbackSuggestions/{suggestionId}": {
      "schema": { "$ref": "#/entities/feedbackSuggestions" },
      "description": "Community feature proposals and upvoting feedback"
    }
  }
}
